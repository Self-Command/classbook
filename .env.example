# PostgreSQL（生产环境改成真实连接串）
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/classbook_dev?schema=public"

# JWT 签名密钥，生产环境务必替换为随机长字符串
JWT_SECRET="change-me-to-a-long-random-secret"

PORT=3000
NODE_ENV=development

# 上传文件目录（相对 apps/api 工作目录）
UPLOAD_DIR="./uploads"

# 首次 seed 创建的管理员（不要使用示例值上线）
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-before-use"

# 生产环境走 HTTPS 时设为 true
COOKIE_SECURE=false

# 开发环境允许的前端来源
WEB_ORIGIN="http://localhost:5173"
ADMIN_ORIGIN="http://localhost:5174"
