generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MessageStatus {
  VISIBLE
  HIDDEN
}

enum MessageVisibility {
  PUBLIC
  PRIVATE
}

enum NotificationType {
  PROFILE_MESSAGE
  POST_COMMENT
  COMMENT_REPLY
  POST_LIKE
  MENTION
}

model User {
  id           String      @id @default(cuid())
  username     String      @unique
  passwordHash String
  role         Role        @default(MEMBER)
  status       UserStatus  @default(ACTIVE)
  theme        String?
  tokenVersion Int         @default(0)
  inviteCodeId String?
  inviteCode   InviteCode? @relation(fields: [inviteCodeId], references: [id])
  profile      Profile?
  messages     Message[]   @relation("author")
  received     Message[]   @relation("recipient")
  comments     MessageComment[] @relation("CommentAuthor")
  likes        MessageLike[]
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationActor")
  albums       Album[]
  timeline     TimelineEvent[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model InviteCode {
  id          String   @id @default(cuid())
  code        String   @unique
  note        String?
  maxUses     Int      @default(1)
  usedCount   Int      @default(0)
  expiresAt   DateTime?
  disabled    Boolean  @default(false)
  createdById String?
  users       User[]
  createdAt   DateTime @default(now())
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  realName  String
  nickname  String?
  avatarUrl String?
  motto     String?
  bio       String?  @db.Text
  location  String?
  birthday  String?
  wechat    String?
  qq        String?
  email     String?
  phone     String?
  updatedAt DateTime @updatedAt
}

model Message {
  id           String            @id @default(cuid())
  authorId     String
  author       User              @relation("author", fields: [authorId], references: [id], onDelete: Cascade)
  toUserId     String?
  toUser       User?             @relation("recipient", fields: [toUserId], references: [id], onDelete: SetNull)
  content      String            @db.Text
  images       String[]          @default([])
  visibility   MessageVisibility @default(PUBLIC)
  status       MessageStatus     @default(VISIBLE)
  commentCount Int               @default(0)
  likeCount    Int               @default(0)
  editedAt     DateTime?
  createdAt    DateTime          @default(now())
  comments     MessageComment[]
  likes        MessageLike[]
  notifications Notification[]

  @@index([status, createdAt])
  @@index([toUserId, status, createdAt])
  @@index([status, visibility, createdAt])
}

model MessageComment {
  id        String          @id @default(cuid())
  messageId String
  message   Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  authorId  String
  author    User            @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    MessageComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   MessageComment[] @relation("CommentReplies")
  content   String          @db.Text
  createdAt DateTime        @default(now())
  notifications Notification[]

  @@index([messageId, createdAt])
  @@index([parentId, createdAt])
}

model MessageLike {
  messageId String
  userId    String
  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([messageId, userId])
  @@index([userId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  type      NotificationType
  messageId String?
  message   Message?         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  commentId String?
  comment   MessageComment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  preview   String?          @db.Text
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}

model Album {
  id          String   @id @default(cuid())
  title       String
  description String?
  coverUrl    String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  photos      Photo[]
  createdAt   DateTime @default(now())
}

model Photo {
  id        String   @id @default(cuid())
  albumId   String
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url       String
  videoUrl  String?
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([albumId, sortOrder])
}

model TimelineEvent {
  id          String   @id @default(cuid())
  date        DateTime
  title       String
  description String?  @db.Text
  imageUrl    String?
  sortOrder   Int      @default(0)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([date])
}

model SiteSetting {
  id             Int      @id @default(1)
  className      String   @default("我们的班级")
  schoolName     String?
  graduationYear Int?
  slogan         String?
  heroImageUrl   String?
  defaultTheme   String   @default("warm")
  imageCompressEnabled     Boolean @default(true)
  imageCompressThresholdKb Int     @default(1024)
  imageMaxDimension        Int     @default(1920)
  imageQuality             Int     @default(82)
  copy                     Json    @default("{}")
  updatedAt      DateTime @updatedAt
}
