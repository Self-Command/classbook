{
  "name": "classbook",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @classbook/api dev",
    "dev:web": "pnpm --filter @classbook/web dev",
    "dev:admin": "pnpm --filter @classbook/admin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @classbook/api test",
    "db:start": "tsx scripts/dev-db.ts start",
    "db:stop": "tsx scripts/dev-db.ts stop",
    "db:migrate": "pnpm --filter @classbook/api db:migrate",
    "db:seed": "pnpm --filter @classbook/api db:seed",
    "db:seed:demo": "pnpm --filter @classbook/api db:seed:demo"
  },
  "devDependencies": {
    "embedded-postgres": "18.6.0-beta.19",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
