# 复制为 deploy/.env 后填写真实值；不要提交到 Git。
IMAGE_PREFIX=ghcr.io/self-command
IMAGE_TAG=latest
WEB_PORT=8080

POSTGRES_USER=classbook
# 只使用 URL 安全字符（字母/数字），避免 DATABASE_URL 拼接失败
POSTGRES_PASSWORD=change-me-url-safe
POSTGRES_DB=classbook

# 生成方式：openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-first-deploy

# 生产使用 HTTPS 时必须为 true
COOKIE_SECURE=true
PUBLIC_ORIGIN=https://classbook.example.com

TZ=Asia/Shanghai
